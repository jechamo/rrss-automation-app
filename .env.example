# Configuracion NO sensible. Copia a .env y ajusta.
# Las API KEYS NO van aqui: se guardan cifradas en el Secret Vault (ver Ajustes).

# Base de datos local SQLite (Prisma)
DATABASE_URL="file:./dev.db"

# Ruta al binario de Claude Code CLI (opcional; si vacio, se autodetecta).
# Ej Windows: C:\\Users\\norkc\\.local\\bin\\claude.exe
CLAUDE_CLI_PATH=""

# Motor de IA por defecto: claude-cli | claude-agent-sdk
AI_ENGINE="claude-cli"
