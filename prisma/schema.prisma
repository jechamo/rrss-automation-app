// Esquema inicial (multiproyecto). Crece por requisito.
// Ver docs/03-arquitectura.md §8.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String         @id @default(cuid())
  name      String
  url       String
  codeType  String? // local | github_public | github_private | none
  codePath  String? // ruta local o URL de repo
  logoPath  String? // ruta relativa en data/media/project-<id>/ (logo manual)
  niche       String?
  createdAt   DateTime       @default(now())
  dossier     Dossier?
  competencia Competencia?
  leads       Leads?
  virales     Virales?
  runs        Run[]
  pieces      ContentPiece[]
}

model Dossier {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String // JSON string con las secciones del dossier
  status    String   @default("draft") // draft | approved
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Competencia {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String // JSON string con la ficha comparativa de competencia
  status    String   @default("draft") // draft | approved
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Leads {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String // JSON string con leads + estrategia (REQ-003)
  status    String   @default("draft") // draft | approved
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Virales {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String // JSON string con Top virales + patrones (REQ-004)
  status    String   @default("draft") // draft | approved
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Run {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requisito String // REQ-001 ...
  status    String   @default("pending") // pending | running | ok | error
  nodes     String // JSON string: estado por nodo
  logs      String? // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentPiece {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  origin     String   @default("viral") // viral (REQ-005) | own (REQ-006)
  sourceUrl  String? // URL del viral clonado (REQ-005)
  titulo     String   @default("")
  plataforma String? // youtube | tiktok | instagram
  content    String   @default("{}") // JSON: guion + escaleta + patron aplicado
  config     String   @default("{}") // JSON: rama (fal|heygen) + modelo video + voz
  assets     String   @default("{}") // JSON: videoPath + audioPath + clips + logs
  runId      String? // ultimo run de generacion (REQ-005) para restaurar el grafo
  status     String   @default("borrador") // borrador | generando | listo | publicado | error
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ConnectorState {
  provider    String    @id // fal | heygen | elevenlabs | gemini | github | ai-engine
  status      String    @default("unset") // ok | error | unset
  lastChecked DateTime?
  detail      String?
  // Las API keys NO se guardan aqui: van al Secret Vault cifrado.
}
